2872445-44dc5f7e3c8f?w=600',source:'AsistenteKitchyIA',canCookWithCurrentStock:!0,steps:[{step:1,title:'Saltear',text:`Dora ${y} a fuego medio 2 minutos.`,timeSeconds:120},{step:2,title:'Cuajar',text:`Vierte los huevos y a\xf1ade ${h} a fuego lento removiendo despacio.`,timeSeconds:180},{step:3,title:'Emplatar',text:'Retira cuando est\xe9 cremoso y sirve caliente.',timeSeconds:60}],ingredients:[...s.map(t=>({name:t,quantity:90,unit:'g',status:'Disponible'})),{name:'Huevos L',quantity:3,unit:'ud',status:'Disponible'}]})}var v=_r(d[6]).INITIAL_RECIPES.map((t,i)=>({...t,id:`recipe-ai-${r}-base-${i}`})),q=function(t){if(n.length>=(i.maxOptions||4))return 1;n.some(i=>i.title.toLowerCase()===t.title.toLowerCase())||n.push(t)};for(var b of v)if(q(b))break;return n.slice(0,i.maxOptions||4)}},{key:"createRecipe",value:(p=(0,i.default)(function*(t,i){var s=i.totalTimeMinutes??20,o={id:`recipe-${Date.now()}`,houseId:t,title:i.title,subtitle:i.subtitle||`${i.servings} personas \xb7 Receta casera`,description:i.description||'',servings:i.servings,totalTimeMinutes:s,prepTimeMinutes:s,difficulty:i.difficulty||'Media',caloriesKcal:i.caloriesKcal||450,pantryMatchPercentage:100,sourceType:'USER_CREATED',imageUrl:i.imageUrl||'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600',source:'UserCustom',canCookWithCurrentStock:!0,isFavorite:!1,steps:i.steps,ingredients:i.ingredients};try{var n=yield _r(d[5]).ApiService.post(`/api/recipes/create?houseId=${encodeURIComponent(t)}`,i);if(n&&n.id)return n}catch{}return o}),function(t,i){return p.apply(this,arguments)})},{key:"updateRecipe",value:(l=(0,i.default)(function*(t,i,s){try{var o=yield _r(d[5]).ApiService.put(`/api/recipes/${encodeURIComponent(t)}?houseId=${encodeURIComponent(i)}`,s);if(o&&o.id)return o}catch{}return s}),function(t,i,s){return l.apply(this,arguments)})},{key:"toggleFavorite",value:(c=(0,i.default)(function*(t,i){try{var s=yield _r(d[5]).ApiService.post(`/api/recipes/${encodeURIComponent(t)}/favorite?houseId=